@model RestaurantManagementSystem.ViewModels.OrderCreateViewModel

<h2>Create Order</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="MenuItemId" class="form-label">
            Menu Item
        </label>

        <select asp-for="MenuItemId" class="form-control">
            <option value="">-- Select Menu Item --</option>

            @foreach (var item in Model.MenuItems)
            {
                <option value="@item.Id">
                    @item.Name
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">
            Quantity
        </label>

        <input asp-for="Quantity" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Create Order
    </button>

</form>